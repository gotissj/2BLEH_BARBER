# Drizzle
DATABASE_URL=file:local.db
# En Turso/LibSQL remoto: DATABASE_URL=libsql://tu-base.turso.io
# DATABASE_AUTH_TOKEN=token_local_o_de_vercel

# Admin seed (solo para `bun run seed`)
ADMIN_NAME=Nombre del administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-por-una-clave-segura

# Correo (opcional; necesario para notificar nuevas reservas)
# RESEND_API_KEY=reemplazar_con_tu_api_key
# EMAIL_FROM=2bleh Barber <reservas@tu-dominio-verificado.com>
# EMAIL_TEST_RECIPIENT=

# WhatsApp (opcional)
# WHATSAPP_ACCESS_TOKEN=reemplazar_con_tu_token
# WHATSAPP_PHONE_NUMBER_ID=reemplazar_con_tu_phone_number_id
# WHATSAPP_API_VERSION=v23.0